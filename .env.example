# Server-side only. Optional: without a key the app runs in offline mock mode.
ANTHROPIC_API_KEY=

# Alternative provider: OpenAI (or any OpenAI-compatible Chat Completions endpoint).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Force a provider when both keys are set: "anthropic" or "openai". Default: Anthropic wins.
# AI_PROVIDER=openai

# Public deployments: visitors bring their own key (Settings > API key in the app). In production the keys
# above are NOT used for visitors unless you opt in. true = serve keyless requests with the keys above,
# false = never. Unset: allowed in development, refused in production.
# AI_ALLOW_SERVER_KEY=false
