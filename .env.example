# Server-side only. Optional: without a key the app runs in offline mock mode.
ANTHROPIC_API_KEY=

# Alternative provider: OpenAI (or any OpenAI-compatible Chat Completions endpoint).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Force a provider when both keys are set: "anthropic" or "openai". Default: Anthropic wins.
# AI_PROVIDER=openai

# Public deployments: visitors bring their own key (Settings > API key in the app). In production the keys
# above are NOT used for visitors unless you opt in. true = serve keyless requests with the keys above,
# false = never. Unset: allowed in development, refused in production.
# AI_ALLOW_SERVER_KEY=false

# ---------- Authentication (Auth.js / NextAuth) ----------

# Required. Signs session JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID,
# type "Web application"). Authorized redirect URI: <your-origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres connection string for the `users` table (email/password accounts). On Vercel, add the
# Postgres (Neon) integration and this is set for you automatically in every environment.
POSTGRES_URL=

# ---------- Media library storage (Cloudflare R2) ----------

# R2 > Manage API tokens > Create API token (Object Read & Write). The S3 endpoint is https://<account id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (r2.dev or a custom domain). The bucket's CORS must allow PUT/GET from your site origin.
R2_PUBLIC_URL=

# ---------- Presenta AI (free AI for signed-in customers, served from pooled OpenRouter keys) ----------

# Comma-separated OpenRouter keys. They join the pool on first use (encrypted in the database); extra keys can be added in /admin/ai.
# If one hits its limit or runs out of credit, the next key takes over on the same request.
OPENROUTER_API_KEYS=
# Default model for the pool (the admin screen can change it). Customers never see it.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Encrypts pooled keys at rest. Defaults to AUTH_SECRET; changing it makes stored keys unreadable.
# KEY_ENCRYPTION_SECRET=
# Comma-separated emails allowed to open /admin/ai. Empty means nobody.
ADMIN_EMAILS=
